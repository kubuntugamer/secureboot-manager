{
    if (!pageContainer) return;

    // 🧼 Purge old layout elements
    qDeleteAll(pageContainer->findChildren<QWidget *>(QString(), Qt::FindDirectChildrenOnly));
    if (pageContainer->layout()) {
        QLayoutItem *item;
