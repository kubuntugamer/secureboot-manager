}

void MainWindow::initializePageStack()
{
    dashboardConsole = new MokDashboardConsole(ui->text_raw_certificate_, this);
    dashboardConsole->renderStartupBrief();

    // 🧹 WIPE ALL PLACEHOLDERS OUT OF THE STACK ENGINE
    while (ui->stackedWidget->count() > 0) {
        QWidget *stalePage = ui->stackedWidget->widget(0);
        ui->stackedWidget->removeWidget(stalePage);
        stalePage->deleteLater();
    }

    // 🔒 INITIALIZE THE REAL RUNTIME PAGE OBJECTS
    MokLedgerPage *ledgerPage = new MokLedgerPage(this);
    ui->stackedWidget->addWidget(ledgerPage);                 // Index 0
    ui->stackedWidget->addWidget(new MokGeneratorPage(this)); // Index 1
    ui->stackedWidget->addWidget(new MokSignerPage(this));    // Index 2
    ui->stackedWidget->setCurrentIndex(0);

    // 🛠️ STEP 1: RESTRENGTHEN THE LAYOUT FIRST
    // Move the status panel container cleanly into MokLedgerPage before assigning signal tracking rules
    if (ui->secureBootStatusPanel && ledgerPage->layout()) {
        QVBoxLayout* ledgerLayout = qobject_cast<QVBoxLayout*>(ledgerPage->layout());
        if (ledgerLayout) {
            ui->secureBootStatusPanel->setParent(ledgerPage);
            ledgerLayout->setSpacing(4);
            ledgerLayout->setContentsMargins(0, 0, 0, 4);
            ledgerLayout->addWidget(ui->secureBootStatusPanel);
        }
    }

    // 📋 STEP 2: TRACK THE TABLE WIDGET PRECISION INSTANCE
    // Pull the active runtime table view managed inside the active ledger page layout map
    QTableWidget *table = ledgerPage->findChild<QTableWidget*>();
    if (!table) {
        table = ledgerPage->getTableWidget();
    }

    // Apply strict header constraints to the localized active table
    if (table && table->horizontalHeader()) {
        table->horizontalHeader()->setSectionResizeMode(0, QHeaderView::Interactive);
        table->horizontalHeader()->setSectionResizeMode(1, QHeaderView::Interactive);
        table->horizontalHeader()->setSectionResizeMode(2, QHeaderView::Stretch);
        table->setColumnWidth(0, 280);
        table->setColumnWidth(1, 200);
    }

    // Audit firmware state flags immediately during stack setup passes
    checkSecureBootHardwareState();

    // 🔒 STEP 3: RE-ENGAGE SELECTION TRACKER SIGNALS
    // Hooking the explicit dynamic table reference reactivates click events instantly
    QVector<MokKeyEntry> activeKeys = MokProvider::getLiveKeys();
    MokSelectionTracker::initTracking(table, ui->text_raw_certificate_, activeKeys);
}

void MainWindow::setupNavigationController()
{
    connect(ui->listWidget, &QListWidget::currentRowChanged, this, [this](int rowIndex) {
        if (rowIndex == 3) {
            ui->listWidget->setCurrentRow(ui->stackedWidget->currentIndex());
            MokAboutDialog aboutWindow(this);
            aboutWindow.exec();
            return;
        }
        ui->stackedWidget->setCurrentIndex(rowIndex);

        if (rowIndex == 0) {
            dashboardConsole->renderStartupBrief();
        } else if (rowIndex == 1) {
            dashboardConsole->renderGenerationBrief();
        } else if (rowIndex == 2) {
            dashboardConsole->renderSigningBrief();
        }
    });
}

void MainWindow::checkSecureBootHardwareState()
{
    // Apply layout aesthetics to the status panel wrapper container inside dark mode maps
    if (ui->secureBootStatusPanel) {
        ui->secureBootStatusPanel->setStyleSheet(
            "QWidget#secureBootStatusPanel { "
            "  background-color: #1e1e24; "
            "  border-top: 1px solid #2d2d35; "
            "  padding-left: 6px; "
            "}"
        );
    }

    // High performance rootless NVRAM verification pipeline
    QFile secureBootFile("/sys/firmware/efi/efivars/SecureBoot-8be4df61-93ca-11d2-aa0d-00e098032b8c");

    if (secureBootFile.open(QIODevice::ReadOnly)) {
        QByteArray hardwarePayload = secureBootFile.readAll();
        secureBootFile.close();

        // Standard bracket array notation safely samples the final single state byte container
        if (!hardwarePayload.isEmpty() && hardwarePayload[hardwarePayload.size() - 1] == 1) {
            ui->secureBootStatusValue->setText("● ENABLED");
            ui->secureBootStatusValue->setStyleSheet("font-weight: bold; color: #2ecc71; font-size: 11px;"); // KDE Green
            return;
        }
    }

    ui->secureBootStatusValue->setText("● DISABLED");
    ui->secureBootStatusValue->setStyleSheet("font-weight: bold; color: #e74c3c; font-size: 11px;"); // KDE Crimson
}


