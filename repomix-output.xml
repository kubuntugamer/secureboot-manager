void MokRemovalWizard::buildRemediationPage()
{
    QWidget *page = new QWidget(this);
    QVBoxLayout *layout = new QVBoxLayout(page);
    layout->setContentsMargins(20, 20, 20, 20);
    layout->setSpacing(12);

    QLabel *lblTitle = new QLabel("🔄 STEP 1: AUTOMATED KERNEL SIGNATURE PURGE", page);
    lblTitle->setStyleSheet("color: #e67e22; font-weight: bold; font-size: 13px;");
    layout->addWidget(lblTitle);

    QLabel *lblDesc = new QLabel(this);
    lblDesc->setWordWrap(true);

    if (affectedKernels.isEmpty()) {
        // 🧼 FIXED STRING PHRASING: Restructured to flow professionally on the user interface screen
        lblDesc->setText(QString("No active kernel dependencies detected for MOK: <b>[%1]</b>.<br><br>"
        "It is completely safe to bypass the unsigning loop and proceed straight to the firmware removal phase.").arg(targetKeyName));
    } else {
        lblDesc->setText(QString("The following custom kernels are actively signed by <b>[%1]</b>. "
        "To prevent system boot failure, the wizard will automatically strip these signatures "
        "using administrative privileges prior to removing the key:").arg(targetKeyName));
    }
    layout->addWidget(lblDesc);

    logTerminal = new QTextBrowser(page);
    logTerminal->setReadOnly(true);
    logTerminal->setFont(QFont("monospace", 10));
    logTerminal->setStyleSheet("background-color: #1e1e24; color: #ffffff; border: 1px solid #3f4142;");
    layout->addWidget(logTerminal);

    if (!affectedKernels.isEmpty()) {
        logTerminal->append("<b style='color: #ff9f43;'>Staged targets for signature extraction:</b>");
        for (const QString &kernel : affectedKernels) {
            logTerminal->append(QString("• %1").arg(kernel));
        }
    } else {
        logTerminal->append("<span style='color: #2ecc71;'>[READY] Dependencies clear. Ready to proceed.</span>");
    }

    QHBoxLayout *btnLayout = new QHBoxLayout();
    btnCancelRemediation = new QPushButton("Cancel Safely", page);
    btnCancelRemediation->setMinimumHeight(38);
    connect(btnCancelRemediation, &QPushButton::clicked, this, &QDialog::reject);

    btnStartRemediation = new QPushButton(this);
    btnStartRemediation->setMinimumHeight(38);
    btnStartRemediation->setFont(QFont("", -1, QFont::Bold));

    if (affectedKernels.isEmpty()) {
        btnStartRemediation->setText("Advance to MOK Deletion ➡️");
        btnStartRemediation->setStyleSheet("background-color: #27ae60; color: #ffffff;");
        connect(btnStartRemediation, &QPushButton::clicked, this, [this]() { wizardStack->setCurrentIndex(1); });
    } else {
        btnStartRemediation->setText("🛠️ Purge Signatures & Proceed");
        btnStartRemediation->setStyleSheet("background-color: #2980b9; color: #ffffff;");
        connect(btnStartRemediation, &QPushButton::clicked, this, &MokRemovalWizard::handleRemediationPipeline);
    }

    btnLayout->addWidget(btnCancelRemediation);
    btnLayout->addWidget(btnStartRemediation);
    layout->addLayout(btnLayout);

    wizardStack->addWidget(page);
}

