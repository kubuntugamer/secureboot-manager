void MainWindow::checkSecureBootHardwareState()
{
    if (ui->secureBootStatusPanel) {
        ui->secureBootStatusPanel->setStyleSheet(
            "QWidget#secureBootStatusPanel { "
            "  background-color: #1e1e24; "
            "  border-top: 1px solid #2d2d35; "
            "  padding-left: 6px; "
            "}"
        );
    }

    QFile secureBootFile("/sys/firmware/efi/efivars/SecureBoot-8be4df61-93ca-11d2-aa0d-00e098032b8c");

    if (secureBootFile.open(QIODevice::ReadOnly)) {
        QByteArray hardwarePayload = secureBootFile.readAll();
        secureBootFile.close();

        if (!hardwarePayload.isEmpty() && hardwarePayload[hardwarePayload.size() - 1] == 1) {
            ui->secureBootStatusValue->setText("● ENABLED");
            ui->secureBootStatusValue->setStyleSheet("font-weight: bold; color: #2ecc71; font-size: 11px;");
            return;
        }
    }

    ui->secureBootStatusValue->setText("● DISABLED");
    ui->secureBootStatusValue->setStyleSheet("font-weight: bold; color: #e74c3c; font-size: 11px;");
}

void MokGeneratorPage::executeMokKeyPairGeneration()
{
    QString commonName = editGenCommonName->text().trimmed();
    int lifespanDays = spinGenDays->value();
    targetOutputFolder = QDir::currentPath() + "/secureboot-manager-keys";

    if (commonName.isEmpty()) {
        QMessageBox::warning(this, "Validation Failed", "Common Name signature tracking label cannot be blank.");
        return;
    }

    textGenerationLog->clear();
    textGenerationLog->append("--- INITIALIZING CRYPTOGRAPHIC PROCESS ENVIRONMENT ---");

    btnGenerateMok->setEnabled(false);
    btnGenerateMok->setText("⚡ Instantiating OpenSSL Engine Subprocess...");

    // 🤝 RE-LINKED MODEL HOOK: Delegates target argument parsing to your helper engine
    MokGenerator localEngine;
    QString structuralLogs = "";

    // We execute the local script creator to layout target directory files securely
    localEngine.generateKeyPair(commonName, lifespanDays, 2048, targetOutputFolder, structuralLogs);
    textGenerationLog->append(structuralLogs);

    // Run the generated command payload array script line completely asynchronously via QProcess
    QString configFilePath = QString("%1/MOK.config").arg(targetOutputFolder);
    QString privateKeyPath = QString("%1/MOK.key").arg(targetOutputFolder);
    QString derCertificatePath = QString("%1/MOK.der").arg(targetOutputFolder);

    QString commandPayload = QString(
        "openssl req -new -x509 -newkey rsa:2048 -nodes -days %1 -config '%2' -keyout '%3' -out '%4' -outform DER"
    ).arg(QString::number(lifespanDays), configFilePath, privateKeyPath, derCertificatePath);

    generatorProcess->start("sh", QStringList() << "-c" << commandPayload);
    if (!generatorProcess->waitForStarted(2000)) {
        textGenerationLog->append("<font color='#e74c3c'>[ERROR]: Failed to invoke OpenSSL framework dependencies.</font>");
        btnGenerateMok->setEnabled(true);
        btnGenerateMok->setText("Generate Custom MOK Key Pair");
    }
}

void MokGeneratorPage::handleGenerationReadyRead()
{
    if (!generatorProcess) return;
    QString errorLines = QString::fromUtf8(generatorProcess->readAllStandardError()).trimmed();
    QString outputLines = QString::fromUtf8(generatorProcess->readAllStandardOutput()).trimmed();

    if (!outputLines.isEmpty()) textGenerationLog->append(outputLines);
    if (!errorLines.isEmpty()) textGenerationLog->append(QString("<font color='#a1a1a1'>%1</font>").arg(errorLines));
}

void MokGeneratorPage::handleGenerationFinished(int exitCode, QProcess::ExitStatus exitStatus)
{
    btnGenerateMok->setEnabled(true);
    btnGenerateMok->setText("Generate Custom MOK Key Pair");

    if (exitStatus == QProcess::CrashExit) {
        textGenerationLog->append("\n<font color='#e74c3c'>❌ Cryptographic execution thread crashed unexpectedly.</font>");
    } else if (exitCode != 0) {
        textGenerationLog->append(QString("\n<font color='#e74c3c'>❌ OpenSSL task failure code: %1</font>").arg(exitCode));
    } else {
        textGenerationLog->append(QString("\n<font color='#1dd1a1'>✨ [SUCCESS]: Cryptographic key pairs generated flawlessly inside:\n%1</font>").arg(targetOutputFolder));
        QMessageBox::information(this, "Success", "Custom cryptographic MOK pair written to disk successfully!");
    }
}


