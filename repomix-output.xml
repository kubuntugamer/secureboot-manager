#include "mokgenerator.h"
#include <QDir>
#include <QFile>
#include <QTextStream>

MokGenerator::MokGenerator(QObject *parent) : QObject(parent) {}

bool MokGenerator::generateKeyPair(const QString &commonName, int days, int keySize, const QString &outputDir, QString &logOutput) {
    Q_UNUSED(keySize);

    QDir dir(outputDir);
    if (!dir.exists()) {
        dir.mkpath(".");
    }

    QString x509ConfigPath = dir.absoluteFilePath("MOK.config");
    logOutput += "📂 Generating explicit cryptographic configuration profiles inside:\n" + x509ConfigPath + "\n";

    // Write a temporary OpenSSL configuration file block natively so configuration flags bind perfectly
    QFile configFile(x509ConfigPath);
    if (configFile.open(QIODevice::WriteOnly | QIODevice::Text)) {
        QTextStream stream(&configFile);
        stream << "[ req ]\n"
        << "default_bits = 2048\n"
        << "distinguished_name = req_distinguished_name\n"
        << "prompt = no\n"
        << "string_mask = utf8only\n"
        << "x509_extensions = myexts\n\n"
        << "[ req_distinguished_name ]\n"
        << "CN = " << commonName << "\n\n"
        << "[ myexts ]\n"
        << "basicConstraints=critical,CA:FALSE\n"
        << "keyUsage=digitalSignature\n"
        << "extendedKeyUsage=codeSigning,1.3.6.1.4.1.2312.16.1.2\n" // Crucial standard validation OID for MOK loading
        << "subjectKeyIdentifier=hash\n"
        << "authorityKeyIdentifier=keyid\n";
        configFile.close();
        return true;
    }

    logOutput += "❌ Error: Failed to write system security configuration file parameters.\n";
    return false;
}


