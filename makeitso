#!/usr/bin/env bash

# 🛡️ THE ARCHITECTURAL REALIGNMENT & SORTING ENGINE
# This script completely automates your project's directory restructuring,
# physically moving files into their clean OOP departmental folders, updating
# the CMake map, clearing out old build junk, and verifying the new structure.

# Visual layout feedback helpers
info()  { echo -e "\e[34m[INFO]\e[0m $1"; }
warn()  { echo -e "\e[33m[WARN]\e[0m $1"; }
error() { echo -e "\e[31m[ERROR]\e[0m $1"; exit 1; }

# 🚀 STEP 1: PRE-FLIGHT BOUNDARY AUDIT
info "Verifying workspace boundaries before reorganization..."

if [ ! -f "CMakeLists.txt" ] || [ ! -f "main.cpp" ]; then
    error "Execution Intercept: Must run this script inside your project's root folder (~/CppSandbox/untitled/)."
fi

# 📂 STEP 2: CREATE DEPARTMENT DIRECTORIES
info "Creating departmental folder structures..."
mkdir -p include src ui

# 📦 STEP 3: MOVE VIEW & PRESENTATION FILES (UI DEPARTMENT)
info "Migrating presentation elements to 'ui/' folder..."
UI_FILES=(
    "mainwindow.cpp" "mainwindow.h" "mainwindow.ui"
    "mokledgerpage.cpp" "mokledgerpage.h"
    "mokgeneratorpage.cpp" "mokgeneratorpage.h"
    "moksignerpage.cpp" "moksignerpage.h"
)

for file in "${UI_FILES[@]}"; do
    if [ -f "$file" ]; then
        mv "$file" ui/
    elif [ -f "ui/$file" ]; then
        info "  -> '$file' already safely located in ui/"
    else
        warn "  -> Specified target element '$file' not found in root (skipping)."
    fi
done

# 🛡️ STEP 4: MOVE CORE BUSINESS LOGIC FILES (SRC DEPARTMENT)
info "Migrating core business logic components to 'src/' folder..."
SRC_FILES=(
    "mokautomationbackend.cpp" "mokautomationbackend.h"
    "mokuiadapter.cpp" "mokuiadapter.h"
    "mokprovider.cpp" "mokprovider.h"
    "mokgenerator.cpp" "mokgenerator.h"
    "mokuigenerator.cpp" "mokuigenerator.h"
    "mokuisigner.cpp" "mokuisigner.h"
    "mokselectiontracker.cpp" "mokselectiontracker.h"
    "mokkeyentry.h"
)

for file in "${SRC_FILES[@]}"; do
    if [ -f "$file" ]; then
        mv "$file" src/
    elif [ -f "src/$file" ]; then
        info "  -> '$file' already safely located in src/"
    else
        warn "  -> Specified target element '$file' not found in root (skipping)."
    fi
done

# 🧬 STEP 5: SEPARATE ALL BLUEPRINT REGISTRY FILES (INCLUDE DEPARTMENT)
info "Isolating header files into 'include/' register mapping..."
# Move all header files from src/ and ui/ into include/ to break up file weight completely
find src/ ui/ -maxdepth 1 -name "*.h" -exec mv {} include/ \; 2>/dev/null

# 🗺️ STEP 6: OVERWRITE THE CMAKELISTS.TXT BUILD BLUEPRINT
info "Rewriting 'CMakeLists.txt' to track the new departmental paths..."
cat << 'EOF' > CMakeLists.txt
cmake_minimum_required(VERSION 3.16)
project(secureboot-manager LANGUAGES CXX)

find_package(Qt6 6.4 REQUIRED COMPONENTS Core Widgets)

qt_standard_project_setup()

# 🔍 MAP THE INCLUDE DIRECTORY SO HEADERS ARE FOUND NATIVELY EVERYWHERE
include_directories(include)

# 🗺️ REGISTER RESTRUCTURED FILE TARGETS ACCORDING TO DEPARTMENT PATHS
qt_add_executable(secureboot-manager
    main.cpp
    
    # 🎨 Presentation & View Department
    ui/mainwindow.cpp
    include/mainwindow.h
    ui/mainwindow.ui
    include/mokledgerpage.h
    ui/mokledgerpage.cpp
    include/mokgeneratorpage.h
    ui/mokgeneratorpage.cpp
    include/moksignerpage.h
    ui/moksignerpage.cpp

    # 🛡️ Core Logic & Submodule Department
    include/mokautomationbackend.h    
    src/mokautomationbackend.cpp  
    include/mokkeyentry.h
    include/mokuiadapter.h
    src/mokuiadapter.cpp
    include/mokprovider.h
    src/mokprovider.cpp
    include/mokgenerator.h
    src/mokgenerator.cpp
    include/mokuigenerator.h         
    src/mokuigenerator.cpp       
    include/mokuisigner.h            
    src/mokuisigner.cpp          
    include/mokselectiontracker.h
    src/mokselectiontracker.cpp
)

target_link_libraries(secureboot-manager
    PRIVATE
        Qt::Core
        Qt::Widgets
)

include(GNUInstallDirs)

install(TARGETS secureboot-manager
    RUNTIME DESTINATION ${CMAKE_INSTALL_BINDIR}
    LIBRARY DESTINATION ${CMAKE_INSTALL_LIBDIR}
)
EOF

# 🧼 STEP 7: FORCE CLEAN CACHE PURGE
info "Scrubbing stale local CMake cache maps to prevent tracking collisions..."
if [ -d "build" ]; then
    rm -rf build/*
    info "  -> Local 'build/' cache completely purged."
fi

echo -e "\n======================================================="
echo -e "🏁 \e[32mPROJECT STRUCTURE COMPLIANCE PIPELINE COMPLETE!\e[0m"
echo -e "🔹 View & UI Layers:   ./ui/"
echo -e "🔹 Business Logic:    ./src/"
echo -e "🔹 Header Blueprint:  ./include/"
echo -e "\e[33m👉 Action Required:\e[0m Open Qt Creator, click 'Build' -> 'Clear CMake Cache', and run a Rebuild!"
echo -e "======================================================="
